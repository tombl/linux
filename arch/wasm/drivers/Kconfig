config VIRTIO_WASM
	tristate "Platform bus driver for WebAssembly virtio devices"
	select VIRTIO
	help
	 This driver supports virtio devices on the WebAssembly platform.

config FB_WASM
	tristate "WebAssembly canvas framebuffer"
	depends on FB
	select FB_DEVICE
	select FB_SYSMEM_HELPERS
	help
	  System-RAM framebuffer presented to the host as a browser canvas
	  via wasm imports. Userspace uses /dev/fb0 with read/write (no mmap).
