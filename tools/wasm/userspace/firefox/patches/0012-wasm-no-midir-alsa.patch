Disable midir-based Web MIDI on wasm32-linux.

midir_linux_support forces pkg-config for alsa even when
--disable-audio-backends is set. Our guest has no ALSA.
--- a/toolkit/moz.configure
+++ b/toolkit/moz.configure
@@ -188,8 +188,12 @@
 # ==============================================================
 @depends(target)
 def midir_linux_support(target):
+    # wasm32-linux (tombl) has no ALSA; exclude like riscv64.
     return (
-        target.kernel == "Linux" and target.os != "Android" and target.cpu != "riscv64"
+        target.kernel == "Linux"
+        and target.os != "Android"
+        and target.cpu != "riscv64"
+        and target.cpu != "wasm32"
     )
 
 
