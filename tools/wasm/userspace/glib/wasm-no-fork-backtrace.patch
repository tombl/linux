glib: skip fork()-based stack traces on wasm.

diff --git a/glib/gbacktrace.c b/glib/gbacktrace.c
--- a/glib/gbacktrace.c
+++ b/glib/gbacktrace.c
@@ -260,6 +260,10 @@ g_on_error_stack_trace (const gchar *prg_name)
 void
 g_on_error_stack_trace (const gchar *prg_name)
 {
+#ifdef __wasm__
+  (void) prg_name;
+  return;
+#else
 #if defined(G_OS_UNIX)
   pid_t pid;
   gchar buf[16];
@@ -306,6 +310,7 @@ g_on_error_stack_trace (const gchar *prg_name)
   else
     g_abort ();
 #endif
+#endif /* __wasm__ */
 }
 
 #ifndef G_OS_WIN32
