 static int MouseInputType;
 
+/* Evdev absolute/relative pointer for virtio-input (/dev/input/event*).
+ * Avoid linux/input.h (not always on the TinyX include path); use the
+ * stable ABI values from include/uapi/linux/input-event-codes.h. */
+#ifndef EV_SYN
+#define EV_SYN			0x00
+#define EV_KEY			0x01
+#define EV_REL			0x02
+#define EV_ABS			0x03
+#define SYN_REPORT		0
+#define REL_X			0x00
+#define REL_Y			0x01
+#define REL_WHEEL		0x08
+#define ABS_X			0x00
+#define ABS_Y			0x01
+#define BTN_LEFT		0x110
+#define BTN_RIGHT		0x111
+#define BTN_MIDDLE		0x112
+#define BTN_SIDE		0x113
+#define BTN_EXTRA		0x114
+#define BTN_FORWARD		0x115
+#define BTN_BACK		0x116
+#endif
+
+/* On wasm32, kernel input_event is 16 bytes: two longs + type/code/value. */
+struct wasm_input_event32 {
+	long tv_sec;
+	long tv_usec;
+	unsigned short type;
+	unsigned short code;
+	int value;
+};
+
+typedef struct _evdevMouse {
+	int fd;
+	int x;
+	int y;
+	unsigned long buttons;
+	Bool pending;
+} EvdevMouse;
+
+static unsigned long EvdevMapButton(unsigned int code)
+{
+	switch (code) {
+	case BTN_LEFT:
+		return KD_BUTTON_1;
+	case BTN_MIDDLE:
+		return KD_BUTTON_2;
+	case BTN_RIGHT:
+		return KD_BUTTON_3;
+	case BTN_SIDE:
+	case BTN_BACK:
+		return KD_BUTTON_4;
+	case BTN_EXTRA:
+	case BTN_FORWARD:
+		return KD_BUTTON_5;
+	default:
+		return 0;
+	}
+}
+
+static void EvdevFlush(KdMouseInfo *mi, EvdevMouse *em)
+{
+	unsigned long flags = em->buttons;	/* absolute: no KD_MOUSE_DELTA */
+	KdEnqueueMouseEvent(mi, flags, em->x, em->y);
+	em->pending = FALSE;
+}
+
+static void EvdevRead(int mousePort, void *closure)
+{
+	KdMouseInfo *mi = closure;
+	EvdevMouse *em = mi->driver;
+	struct wasm_input_event32 ev[32];
+	ssize_t n;
+	int i, count;
+
+	(void)mousePort;
+	while ((n = read(em->fd, ev, sizeof(ev))) > 0) {
+		count = n / (ssize_t)sizeof(struct wasm_input_event32);
+		for (i = 0; i < count; i++) {
+			unsigned int type = ev[i].type;
+			unsigned int code = ev[i].code;
+			int value = ev[i].value;
+
+			if (type == EV_ABS) {
+				if (code == ABS_X) {
+					em->x = value;
+					em->pending = TRUE;
+				} else if (code == ABS_Y) {
+					em->y = value;
+					em->pending = TRUE;
+				}
+			} else if (type == EV_REL) {
+				if (code == REL_X) {
+					KdEnqueueMouseEvent(mi,
+							    em->buttons |
+							    KD_MOUSE_DELTA,
+							    value, 0);
+					em->pending = FALSE;
+				} else if (code == REL_Y) {
+					KdEnqueueMouseEvent(mi,
+							    em->buttons |
+							    KD_MOUSE_DELTA,
+							    0, value);
+					em->pending = FALSE;
+				} else if (code == REL_WHEEL) {
+					unsigned long wheel =
+					    value > 0 ? KD_BUTTON_4 :
+					    KD_BUTTON_5;
+					KdEnqueueMouseEvent(mi,
+							    em->buttons | wheel,
+							    em->x, em->y);
+					KdEnqueueMouseEvent(mi, em->buttons,
+							    em->x, em->y);
+					em->pending = FALSE;
+				}
+			} else if (type == EV_KEY) {
+				unsigned long btn = EvdevMapButton(code);
+				if (btn) {
+					if (value)
+						em->buttons |= btn;
+					else
+						em->buttons &= ~btn;
+					em->pending = TRUE;
+				}
+			} else if (type == EV_SYN && code == SYN_REPORT) {
+				if (em->pending)
+					EvdevFlush(mi, em);
+			}
+		}
+	}
+}
+
+static Bool EvdevOpen(KdMouseInfo *mi, const char *path, int fd)
+{
+	EvdevMouse *em;
+
+	em = calloc(1, sizeof(*em));
+	if (!em) {
+		close(fd);
+		return FALSE;
+	}
+	em->fd = fd;
+	em->x = 0;
+	em->y = 0;
+	if (!mi->name)
+		mi->name = strdup(path);
+	mi->driver = em;
+	mi->inputType = MouseInputType;
+	mi->transformCoordinates = FALSE;
+	if (!KdRegisterFd(MouseInputType, fd, EvdevRead, (void *)mi)) {
+		if (mi->name) {
+			free(mi->name);
+			mi->name = 0;
+		}
+		free(em);
+		mi->driver = 0;
+		mi->inputType = 0;
+		close(fd);
+		return FALSE;
+	}
+	ErrorF("Using evdev pointer %s\n", path);
+	return TRUE;
+}
+
+static Bool path_is_evdev(const char *path)
+{
+	return path && strncmp(path, "/dev/input/event", 16) == 0;
+}
