+#ifdef __wasm__
+/* wasm32-linux musl hides fork(); Xfbdev does not need shell helpers. */
+int
+System(char *command)
+{
+    (void)command;
+    errno = ENOSYS;
+    return -1;
+}
+
+pointer
+Popen(char *command, char *type)
+{
+    (void)command;
+    (void)type;
+    errno = ENOSYS;
+    return NULL;
+}
+
+pointer
+Fopen(char *file, char *type)
+{
+    if (file == NULL || type == NULL)
+	return NULL;
+    return fopen(file, type);
+}
+
+int
+Pclose(pointer iop)
+{
+    if (!iop)
+	return -1;
+    return fclose(iop) == 0 ? 0 : -1;
+}
+
+int
+Fclose(pointer iop)
+{
+    if (!iop)
+	return -1;
+    return fclose(iop);
+}
